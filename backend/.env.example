# ZaraiLink Backend Environment Configuration
# Copy this file to .env and add your local values.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signed URL for the trained model in the private ml-models bucket (scripts/fetch_model_weights.py).
MODEL_WEIGHTS_URL=

# Comma-separated origins allowed to make cross-origin browser requests (Swagger UI, a future
# admin web surface). Has no effect on the React Native app itself. Defaults to local-dev-only
# origins if unset — override explicitly for any deployed environment.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081

# MODEL_VERSION is intentionally NOT an env var to set here — it's derived automatically from
# backend/app/ai/checkpoints/model_metadata.json (model name, training date, validation accuracy)
# by app/config/settings.py, so it self-updates whenever the model is retrained. Only set MODEL_VERSION
# explicitly if you need to override that derived value for a specific deployment.

# Error tracking (gate G5, docs/process/briefs/g5-sentry.md). Leave empty to keep it off; when set, the
# API reports unhandled errors to Sentry with request bodies, credentials and contact details removed.
SENTRY_DSN=

# Outgoing email: the approval and rejection emails (app/common/email.py). Off unless EMAIL_ENABLED=true. For the local
# Supabase stack, these values send to its mail catcher (Mailpit, read at http://127.0.0.1:54324):
#   EMAIL_ENABLED=true  SMTP_HOST=127.0.0.1  SMTP_PORT=54325  SMTP_STARTTLS=false
# A hosted deployment sets its provider's values as host secrets (gate G1, docs/process/briefs/g1-smtp.md), never here.
# The other settings are left commented: an empty value would not parse as a port or a yes/no.
EMAIL_ENABLED=false
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ZaraiLink <no-reply@zarailink.local>
# SMTP_STARTTLS=false
