# Editor-agnostic formatting baseline. Prettier and ruff remain the source of truth for code
# style; this only keeps editors from fighting them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
