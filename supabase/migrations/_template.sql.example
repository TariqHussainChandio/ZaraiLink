-- Template for a migration that adds a table. Copy it to supabase/migrations/<timestamp>_<name>.sql and to a
-- paired pgTAP file supabase/tests/database/<timestamp>_<name>.test.sql; `python scripts/check_migrations.py`
-- (run in CI) rejects a migration that leaves any of these out. Explain WHY in comments, citing the business rule
-- (for example BR-09) where one applies.
--
-- Validate it on a database built only from migrations: `npx supabase db reset`, then `npx supabase test db`.
-- Never edit a migration after it has been pushed to a real project; add a new one.

create table public.example_items (
  id uuid primary key default gen_random_uuid(),
  -- Foreign keys are indexed below: a delete or join on the referenced row otherwise scans this table.
  owner_id uuid not null references public.profiles (id) on delete cascade,
  title text not null,
  created_at timestamptz not null default now()
);

alter table public.example_items enable row level security;

-- Explicit grants: from 30 Oct 2026 Supabase does not expose new tables to the Data API by default. Grant only
-- what the app needs, to the roles that need it (anon almost never).
grant select, insert, update, delete on public.example_items to authenticated;

-- Index every foreign key and every column a policy compares with the caller.
create index example_items_owner_id_idx on public.example_items (owner_id);

-- `(select auth.uid())`, never a bare `auth.uid()`: the select makes Postgres evaluate it once per statement
-- instead of once per row. Suspended users may read but not write (rls_suspension_enforcement).
create policy "example_items_select_owner" on public.example_items for select
  using (owner_id = (select auth.uid()));
create policy "example_items_insert_owner" on public.example_items for insert
  with check (owner_id = (select auth.uid()) and not (select public.is_suspended()));

-- A SECURITY DEFINER function must pin its search_path (pg_temp last), or a caller can shadow what it resolves.
-- create function public.example() returns void language sql security definer set search_path = public, pg_temp as $$ select 1 $$;
