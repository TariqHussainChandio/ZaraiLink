{
  "name": "ZaraiLink",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "start": "expo start --dev-client",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "deadcode": "knip",
    "api:generate": "openapi-ts",
    "api:check": "openapi-ts && python scripts/ci/check_generated_clean.py frontend/services/api/generated",
    "reality": "python scripts/check_reality.py --tools knip,eslint",
    "hooks:install": "lefthook install",
    "prebuild": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --platform android --clean",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-mono": "^0.4.1",
