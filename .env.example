# ZaraiLink app configuration. Copy this file to .env and add your local values.
#
# Every EXPO_PUBLIC_ value is baked into the app bundle at build time, so anyone who installs the
# app can read it. Only public values belong here, never a secret. Restart Metro after editing.

# From `npx supabase status -o env`: ANON_KEY, and API_URL with 127.0.0.1 replaced by 10.0.2.2 on the
# emulator (or the host's LAN IP on a phone). 127.0.0.1 would point at the device itself.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Android emulator reaches the host machine at 10.0.2.2, not 127.0.0.1 or localhost. A
# physical device needs the host's LAN IP. Run the backend with --host 0.0.0.0 in that case.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# One of: development, staging, production, test.
EXPO_PUBLIC_APP_ENV=development
