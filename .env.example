# ZaraiLink Environment Configuration
# Copy this file to .env and add your local values.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Use the host machine's LAN IP (not 127.0.0.1/localhost) — the Android emulator and physical
# devices can't reach the host's loopback interface. Run the backend with --host 0.0.0.0.
API_BASE_URL=http://192.168.1.100:8000

APP_ENV=development
