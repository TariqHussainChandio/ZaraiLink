# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.expo/
.expo-shared/

# React Native
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.idea/
android/.cxx/
android/app/.cxx/

# Metro
.metro-health-check*

# iOS
ios/Pods/
ios/build/
ios/DerivedData/
*.xcworkspace
*.xcuserstate

# Environment variables
.env
.env.*
!.env.example

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp

# Supabase local development
.supabase/

# Secrets / credentials
*.pem
*.key
service-account*.json
*.keystore
!android/app/debug.keystore
google-services.json
GoogleService-Info.plist

# ML model/cache files
__pycache__/
*.h5
*.keras
*.ckpt
# Ruby Bundler
.bundle/
