# ================================
# ZaraiLink - Git Ignore
# ================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.expo/
.expo-shared/
coverage/

# Native projects are generated, not checked in: `npm run prebuild` writes android/ from
# app.config.ts and package.json (Expo Continuous Native Generation). Edit those, never android/.
/android/
/ios/

# Metro
.metro-health-check*

# Environment variables
.env
.env.*
!.env.example

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.json
htmlcov/

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp

# Supabase local development
.supabase/

# Secrets / credentials
*.pem
*.key
service-account*.json
*.keystore
google-services.json
GoogleService-Info.plist

# ML model/cache files
__pycache__/
*.h5
*.keras
*.ckpt
# Ruby Bundler
.bundle/

# Claude Code runtime state (session lock — not project content)
.claude/scheduled_tasks.lock
