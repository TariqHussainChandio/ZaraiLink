# ================================
# ZaraiLink - Git Ignore
# ================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.expo/
.expo-shared/
coverage/

# Native projects are generated, not checked in: `npm run prebuild` writes android/ from
# app.config.ts and package.json (Expo Continuous Native Generation). Edit those, never android/.
/android/
/ios/

# Metro
.metro-health-check*

# Environment variables
.env
.env.*
!.env.example

# JWT signing keys (P4, gate-free — private key material, never committed; see
# supabase/config.toml's [auth] signing_keys_path comment).
supabase/signing_keys.json

# Go-public prep (standardization plan P3 §6.4): this file hardcodes a real Supabase project ref
# (read-only, but still project-identifying). Local setup uses .mcp.json.example as a template.
.mcp.json

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.json
htmlcov/

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp

# Supabase local development
.supabase/
# `supabase start` writes its edge-runtime bundle here — `*.temp` above matches files named
# literally that, not this directory.
supabase/.temp/

# Secrets / credentials
*.pem
*.key
service-account*.json
*.keystore
google-services.json
GoogleService-Info.plist

# ML model/cache files
__pycache__/
*.h5
*.keras
*.ckpt
# The trained disease-advisory checkpoint (security fix C5, gate G8): hosted on GitHub Releases
# and fetched by scripts/fetch_model_weights.py instead of being tracked in git, so a retrain no
# longer adds ~9 MB to history every time. model_metadata.json (the pinned URL + SHA-256) stays
# tracked.
backend/app/ml/checkpoints/model.pth
# Ruby Bundler
.bundle/

# Claude Code runtime state (session lock — not project content)
.claude/scheduled_tasks.lock
