{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // An index into an array or record may be missing, so the result must be checked before it is used.
    "noUncheckedIndexedAccess": true,
    // Babel compiles one file at a time, so code must not rely on cross-file type information.
    "isolatedModules": true,
    "types": ["jest", "expo/types"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // app.config.ts runs in Node, not on the phone; tsconfig.node.json checks it with Node's types. Keeping it out of this
  // program keeps Node's globals (Buffer, __dirname) from type-checking in app code, where Hermes has none.
  "exclude": ["node_modules", "app.config.ts"]
}
